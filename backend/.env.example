# Copy to .env and fill in real values. Never commit .env.

# Public site URL, used by tools/make_qr.py for the printed QR (leave empty for local WiFi mode)
PUBLIC_BASE_URL=

# Flask
SECRET_KEY=change-me-to-a-long-random-string
FLASK_DEBUG=0
HOST=0.0.0.0
PORT=5001

# SQLite file. Relative paths are resolved against the backend/ folder,
# so "rvm.db" -> backend/rvm.db locally and /home/<USERNAME>/RVm/backend/rvm.db on PythonAnywhere
DATABASE_PATH=rvm.db

# Shared secret the ESP32 sends in the X-Machine-Key header.
# Must match MACHINE_KEY in firmware/rvm_esp32/config.h
MACHINE_KEY=replace-with-random-key
# Password for /admin (username: admin). Empty = admin page disabled
ADMIN_PASSWORD=change-me

# Comma separated machine IDs this server accepts
MACHINE_IDS=RVM-01

# Reward per item, in rupees
PRICE_BOTTLE=1
PRICE_CAN=2

# Server-side backup: auto-end a session after this many idle seconds
# (the ESP32 itself ends after 60 s without items)
SESSION_TIMEOUT_S=300

# Deposits beyond this are rejected ("Limit reached")
MAX_ITEMS_PER_SESSION=20

# Only "mock" is supported for now (no real money)
PAYOUT_MODE=mock
